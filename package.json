{
  "name": "schedu-le",
  "private": true,
  "type": "module",
  "workspaces": ["api", "web"],
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w web && npm run build -w api",
    "start": "npm run start -w api",
    "migrate": "npm run migrate -w api",
    "seed": "npm run seed -w api --",
    "typecheck": "npm run typecheck -w api && npm run typecheck -w web",
    "test": "npm run test -w api"
  }
}
